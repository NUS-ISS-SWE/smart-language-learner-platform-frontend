# ── Spring Boot Microservice URLs ───────────────────────────────────────────────
# Prefix with NEXT_PUBLIC_ so these values are available in the browser bundle.
# Copy this file to .env.local and adjust the values for your environment.

# Authentication microservice  (e.g., spring-security / JWT issuer)
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8081

# User-profile microservice
NEXT_PUBLIC_USER_SERVICE_URL=http://localhost:8082

# Course / lesson microservice
NEXT_PUBLIC_COURSE_SERVICE_URL=http://localhost:8083

# Vocabulary microservice
NEXT_PUBLIC_VOCABULARY_SERVICE_URL=http://localhost:8084
