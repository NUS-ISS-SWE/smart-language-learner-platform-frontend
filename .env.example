# Smart Language Learner Platform - Frontend Environment Variables
# Copy this file to .env.local and update values for your environment
#
# Note: All NEXT_PUBLIC_* variables are accessible in the browser bundle
# Never store secrets (API keys, tokens) in .env.example or commit them to git
# TODO (backend local setup): set AUDIT_INGEST_SECRET and AUDIT_DB_PASSWORD in the
# backend repository's .env file. Never add those values as NEXT_PUBLIC_* variables.

# ============================================================================
# Microservice URLs - Spring Boot services
# ============================================================================

# Authentication microservice (JWT issuer, user login/register)
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8081

# User profile and preferences microservice
NEXT_PUBLIC_USER_SERVICE_URL=http://localhost:8082

# Course and lesson content microservice
NEXT_PUBLIC_COURSE_SERVICE_URL=http://localhost:8083

# Vocabulary and language data microservice
NEXT_PUBLIC_VOCABULARY_SERVICE_URL=http://localhost:8084

# Composition submission and management microservice
NEXT_PUBLIC_COMPOSITION_SERVICE_URL=http://localhost:8085

# Evaluation and grading microservice
NEXT_PUBLIC_EVALUATION_SERVICE_URL=http://localhost:8086

# Rubric management microservice
NEXT_PUBLIC_RUBRIC_SERVICE_URL=http://localhost:8087

# Analytics and reporting microservice
NEXT_PUBLIC_ANALYTICS_SERVICE_URL=http://localhost:8088

# ============================================================================
# Application Configuration
# ============================================================================

# API Gateway URL baked into the browser bundle when the frontend is built.
# Set this to http://localhost:8080 when building or running locally.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# API request timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT=10000

# ============================================================================
# Feature Flags (for gradual feature rollout)
# ============================================================================

# Enable analytics features
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Enable advanced rubrics functionality
NEXT_PUBLIC_ENABLE_ADVANCED_RUBRICS=false

# Enable peer review features
NEXT_PUBLIC_ENABLE_PEER_REVIEW=false

# Enable AI-powered feedback (requires backend AI service)
NEXT_PUBLIC_ENABLE_AI_FEEDBACK=false

# ============================================================================
# Third-party Services (Optional)
# ============================================================================

# Error tracking service (e.g., Sentry)
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# Analytics service (e.g., Google Analytics)
# NEXT_PUBLIC_GA_ID=UA-XXXXXXXXX-X

# ============================================================================
# Developer Settings (Not used in production)
# ============================================================================

# Enable detailed console logging
NEXT_PUBLIC_DEBUG_LOGGING=false

# Log all API calls to console
NEXT_PUBLIC_LOG_API_CALLS=false

# ============================================================================
# Usage Notes
# ============================================================================
# 1. Local Development:
#    - Copy to .env.local
#    - Update service URLs if running backend locally
#    - Do NOT commit .env.local (it's in .gitignore)
#
# 2. Production:
#    - Set NODE_ENV=production
#    - Use proper security practices for environment variables
#    - Use deployment platform's environment variable management
#
# 3. Configuration Priority:
#    1. .env.production (for production builds)
#    2. .env.development (for dev builds)
#    3. .env.local (local overrides, not committed)
#    4. .env.example (default/documentation, committed)
#
# 4. Microservice Port Mapping:
#    8081 = Auth Service
#    8082 = User Service
#    8083 = Course Service
#    8084 = Vocabulary Service
#    8085 = Composition Service
#    8086 = Evaluation Service
#    8087 = Rubric Service
#    8088 = Analytics Service
